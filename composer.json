{
  "name": "b2pweb/bdf-prime-indexer",
  "description": "Indexer plugin for Prime",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Vincent Quatrevieux",
      "email": "vquatrevieux@b2pweb.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "Bdf\\Prime\\Indexer\\": "src"
    },
    "files": [
      "src/polyfill-sf6.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Bdf\\Prime\\Indexer\\": "tests",
      "ElasticsearchTestFiles\\": "tests/Elasticsearch/_files",
      "DenormalizeTestFiles\\": "tests/Denormalize/_files"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "~7.4 | ~8.0.0 | ~8.1.0 | ~8.2.0 | ~8.3.0 | ~8.4.0 | ~8.5.0",
    "b2pweb/bdf-prime": "~2.2|~3.0",
    "elasticsearch/elasticsearch": "~7.0|~8.0",
    "b2pweb/bdf-collections": "^1.1.4"
  },
  "require-dev": {
    "phpunit/phpunit": "~9.0",
    "b2pweb/bdf-prime-bundle": "dev-feature-FRAM-233-prime-v3 as 1.11.0",
    "symfony/framework-bundle": "~4.0|~5.0|~6.0|~7.0|~8.0",
    "symfony/messenger": "~4.0|~5.0|~6.0|~7.0|~8.0",
    "symfony/console": "~4.0|~5.0|~6.0|~7.0|~8.0",
    "symfony/yaml": "~4.0|~5.0|~6.0|~7.0|~8.0",
    "vimeo/psalm": "~5.22 | ~6.0",
    "squizlabs/php_codesniffer": "~3.0"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "scripts": {
    "tests": "phpunit",
    "tests-with-coverage": "phpunit --coverage-clover coverage.xml",
    "psalm": "psalm --shepherd"
  }
}
